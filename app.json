{
  "expo": {
    "name": "Чё-Там",
    "slug": "che-tam",
    "version": "0.6.6",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "net.hearth.chetam",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/che-tam-brand-mark.png",
        "backgroundColor": "#0F5C48",
        "monochromeImage": "./assets/brand/che-tam-notification-icon.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "notification": {
      "icon": "./assets/brand/che-tam-notification-icon.png",
      "color": "#0F5C48"
    },
    "extra": {
      "canaryEndpoint": "${EXPO_PUBLIC_CANARY_ENDPOINT}",
      "canaryControlDns": "https://turkmenportal.com/",
      "canaryControlHttp": "https://www.apple.com/"
    }
  }
}
