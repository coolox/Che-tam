# Hearth Canary v4 coturn template. Substitute placeholders from
# /root/canary-data/secrets.env or an equivalent local config source before use.

listening-ip=0.0.0.0
listening-port=3478
tls-listening-port=5349

no-udp
no-dtls
no-multicast-peers
no-cli

use-auth-secret
static-auth-secret={{CANARY_TURN_AUTH_SECRET}}
realm={{CANARY_TURN_REALM}}
server-name={{CANARY_TURN_HOST}}

cert={{LETSENCRYPT_FULLCHAIN_PATH}}
pkey={{LETSENCRYPT_PRIVKEY_PATH}}

allow-loopback-peers
denied-peer-ip=0.0.0.0-126.255.255.255
allowed-peer-ip=127.0.0.1
denied-peer-ip=128.0.0.0-255.255.255.255
denied-peer-ip=::-ffff:ffff:ffff:ffff:ffff:ffff:ffff:ffff

user-quota=8
total-quota=16
max-bps=262144
stale-nonce=600
fingerprint
no-software-attribute
